<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xkondix</groupId>
        <artifactId>ai-agents-JAVA-SPRING</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>mcp-server</artifactId>
    <name>MCP Server - Spring Boot MCP tools provider</name>
    <description>
        Standalone Spring Boot application that exposes tools via MCP protocol.
        Both LangChain4j and Spring AI agents connect to this server as an
        external tool provider via HTTP/SSE or Streamable HTTP.

        Tools exposed:
        - get_game_stats  : fetch game statistics
        - save_note       : save a note to the knowledge base
        - search_notes    : search notes in the knowledge base
        - get_weather     : mock weather tool (demo)

        Port: 8081

        Spring AI 1.1.4 notes:
          - Use spring-ai-starter-mcp-server-webmvc (NOT io.modelcontextprotocol.sdk:mcp-spring-webmvc)
          - The low-level mcp-spring-webmvc is a transitive dependency managed by Spring AI BOM
          - Do NOT declare mcp-spring-webmvc or mcp-bom explicitly
    </description>

    <dependencies>

        <!-- Spring Boot Web -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring AI MCP Server WebMVC starter.
            This is the correct Spring AI 1.1.x way to expose MCP tools via HTTP.
            Transitively provides mcp-spring-webmvc at the correct version (managed by BOM).
            Do NOT use io.modelcontextprotocol.sdk:mcp-spring-webmvc directly.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- Actuator for health checks -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- SpringDoc OpenAPI UI -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- Common DTOs -->
        <dependency>
            <groupId>com.xkondix</groupId>
            <artifactId>common</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
