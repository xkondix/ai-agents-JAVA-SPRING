<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xkondix</groupId>
        <artifactId>ai-agents-JAVA-SPRING</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>spring-ai-agent-mcp</artifactId>
    <name>Spring AI Agent MCP - Orchestrator with external MCP servers</name>
    <description>
        Demonstrates MCP client integration in Spring AI:

        1. Autoconfigured MCP clients from application.yml
        2. SyncMcpToolCallbackProvider - MCP tools as Spring AI ToolCallbacks
        3. Orchestrator - ChatClient using tools from multiple MCP servers

        Connects to:
          - mcp-server      (port 8081) via HTTP
          - code-mcp-server (port 8086) via HTTP

        Port: 8085
    </description>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Both model starters are on the classpath; the ACTIVE PROFILE picks
             the provider via spring.ai.model.chat (ollama | openai), so only
             one ChatModel bean is ever created:
               profile local      → Ollama on localhost:11434
               profile openrouter → OpenAI-compatible API (default profile)  -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!--
            Spring AI MCP Client starter
            Autoconfigures MCP clients from application.yml connections.
            Provides SyncMcpToolCallbackProvider bean automatically.
        -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xkondix</groupId>
            <artifactId>common</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
