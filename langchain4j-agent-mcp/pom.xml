<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xkondix</groupId>
        <artifactId>ai-agents-JAVA-SPRING</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>langchain4j-agent-mcp</artifactId>
    <name>LangChain4j Agent MCP - Orchestrator with external MCP servers</name>
    <description>
        Demonstrates MCP client integration in LangChain4j:

        1. HTTP transport - connects to mcp-server (port 8081)
        2. STDIO          - claude-mcp-server is dedicated to Claude Desktop
        3. Orchestrator   - single agent delegating to multiple MCP servers

        Port: 8083
    </description>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- ── STARTERS: the spring-boot4 family ────────────────────────
             Same version as the Boot 3 variants, different artifactId.
             Managed by langchain4j-bom 1.16.3. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama-spring-boot4-starter</artifactId>
        </dependency>

        <!-- OpenAI-compatible starter — used by the "openrouter" Spring
             profile (langchain4j.open-ai.* properties). Property-driven:
             with the "local" profile no open-ai properties exist, so no
             OpenAI model bean is created and no API key is required. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot4-starter</artifactId>
        </dependency>

        <!--
            LangChain4j MCP Client — Streamable HTTP transport.
            Non-starter artifact: no spring-boot4 variant, unchanged.

            WATCH THE SERVER SIDE: in Spring AI 2.0 the SSE transport is
            deprecated and Streamable HTTP is the default server protocol.
            If mcp-server (8081) changes transport, this client has to be
            reconfigured together with it.
        -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-mcp</artifactId>
        </dependency>

        <!-- Actuator: endpoints AND the condition that enables OTLP log export
             (ConditionalOnEnabledLoggingExport). Do not remove. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xkondix</groupId>
            <artifactId>common</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
