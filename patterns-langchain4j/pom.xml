<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xkondix</groupId>
        <artifactId>ai-agents-JAVA-SPRING</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>patterns-langchain4j</artifactId>
    <name>Patterns LangChain4j - Agentic workflow patterns via DSL</name>
    <description>
        The five workflow patterns (Anthropic "Building Effective Agents")
        implemented in LangChain4j. KEY POINT: LC4j ships a dedicated
        Agentic DSL (sequenceBuilder / loopBuilder / conditionalBuilder)
        — compare with the hand-rolled Java in patterns-spring-ai.
        One class per pattern. AC Milan domain tools.
        Port: 8087
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>

        <!-- ── STARTERS: the spring-boot4 family ────────────────────────
             Same version as the Boot 3 variants, different artifactId.
             Managed by langchain4j-bom 1.16.3. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot4-starter</artifactId>
        </dependency>

        <!-- Agentic DSL: sequenceBuilder / loopBuilder / conditionalBuilder.
             Non-starter artifact, independent of the Boot version.
             Version managed by langchain4j-bom (beta line, same as
             langchain4j-mcp — resolves to 1.16.3-beta26). -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-agentic</artifactId>
        </dependency>

        <!-- Actuator: endpoints AND the condition that enables OTLP log export
             (ConditionalOnEnabledLoggingExport). Do not remove. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xkondix</groupId>
            <artifactId>common</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
