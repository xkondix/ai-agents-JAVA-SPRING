<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xkondix</groupId>
        <artifactId>ai-agents-JAVA-SPRING</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>spring-ai-agent-local</artifactId>
    <name>Spring AI Agent Local - ChatClient + Advisors + local tools</name>
    <description>
        Demonstrates the agent loop concept using Spring AI
        with LOCAL tools (@Tool annotation, same process).

        1. RAW LOOP    - same manual loop as in langchain4j-agent-local for comparison
        2. CHAT CLIENT - fluent ChatClient API with prompt builder
        3. ADVISORS    - MessageChatMemoryAdvisor, SimpleLoggerAdvisor, ApprovalAdvisor
        4. TOOLS       - @Tool annotation (Spring AI approach)
        5. MEMORY      - InMemoryChatMemoryRepository

        Port: 8084
    </description>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Both model starters are on the classpath; the ACTIVE PROFILE picks
             the provider via spring.ai.model.chat (ollama | openai), so only
             one ChatModel bean is ever created:
               profile local      → Ollama on localhost:11434
               profile openrouter → OpenAI-compatible API (default profile)  -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-ollama</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- RENAMED IN SPRING AI 2.0.
             Was: spring-ai-advisors-vector-store
             Now: spring-ai-vector-store-advisor
             The module was renamed to match the naming convention of the other
             Spring AI modules. The old coordinate no longer exists in the 2.0
             BOM, so Maven cannot resolve a version for it and the reactor fails
             before compiling anything:
               'dependencies.dependency.version' ... is missing
             That message reads like a POM mistake, but it is a rename. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store-advisor</artifactId>
        </dependency>

        <!-- Redis chat memory (uncomment when Docker is running) -->
        <!-- <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-redis-store</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency> -->

        <!-- Actuator: endpoints AND the condition that enables OTLP log export
             (ConditionalOnEnabledLoggingExport). Do not remove. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xkondix</groupId>
            <artifactId>common</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
