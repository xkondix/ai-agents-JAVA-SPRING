<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- STANDALONE MODULE — deliberately NOT part of ai-agents-JAVA-SPRING.
         It runs Spring AI 2.0 / Spring Boot 4 while the rest of the project
         stays on Spring AI 1.1.4 / Boot 3.5.

         spring-boot-starter-parent is not cosmetic here: it sets -parameters.
         @McpToolParam has no `name` attribute, so reflection metadata is the
         ONLY source of parameter names in the generated JSON schema. Without
         the flag every argument is published as arg0/arg1 and arrives as null,
         with no error anywhere. ToolSchemaContractTest asserts it.

         4.0.4 rather than 4.0.0: two advisories against actuator
         (GHSA-8hfc-fq58-r658, GHSA-mgvc-8q2h-5pgc) are fixed there. Both are
         authentication bypasses on actuator ENDPOINTS, which this module never
         exposes — but a silent scanner is worth more than an argument about
         reachability. Verified before bumping: 4.0.4 still manages
         opentelemetry-bom 1.55.0, so the appender pinning below still holds. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.4</version>
        <relativePath/>
    </parent>

    <groupId>com.xkondix</groupId>
    <artifactId>claude-mcp-server</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>Claude MCP Server - project file access for Claude Desktop</name>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.0</spring-ai.version>
        <!-- Boot manages io.opentelemetry:opentelemetry-bom (1.55.0) but NOT the
             io.opentelemetry.instrumentation group, so the Logback appender needs
             an explicit version. Instrumentation 2.21.0 is the release that
             targets OTel SDK 1.55.0 — check that pairing when bumping Boot. -->
        <otel-instrumentation.version>2.21.0-alpha</otel-instrumentation.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- STDIO MCP server. HTTP transport is a separate starter in 2.0
             (spring-ai-starter-mcp-server-webmvc) — do NOT add it here, an
             accidental Tomcat would write to stdout and corrupt JSON-RPC. -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server</artifactId>
        </dependency>

        <!-- Declared explicitly even though the MCP starter pulls it in:
             this is where @McpTool / @McpToolParam live in 2.0
             (org.springframework.ai.mcp.annotation, moved from the
             org.springaicommunity incubator). -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-mcp-annotations</artifactId>
        </dependency>

        <!-- OBSERVABILITY — the reason this module would not start.
             Spring Boot 4 moved tracing auto-configuration OUT of actuator
             into dedicated modules. The previous hand-picked set
             (actuator + micrometer-tracing-bridge-otel + opentelemetry-exporter-otlp
             + micrometer-registry-otlp) put the Micrometer Tracing API on the
             classpath but nothing that auto-configures it, so no Tracer bean
             was ever created and constructor injection failed at startup.

             spring-boot-starter-opentelemetry (new in Boot 4) is the whole
             package: OpenTelemetry API + SDK auto-configuration,
             micrometer-tracing-bridge-otel, the OTLP exporters for traces and
             logs, and micrometer-registry-otlp for metrics. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <!-- ACTUATOR IS REQUIRED FOR LOG EXPORT. NOT FOR ENDPOINTS.

             This module has no web server, so it exposes no actuator endpoint
             and never will. It is here for one reason: a @ConditionalOnClass.

             Compare the two auto-configurations in Boot 4:

               @ConditionalOnClass({ OtelTracer.class, SdkTracerProvider.class,
                                     OpenTelemetry.class, OtlpHttpSpanExporter.class })
               class OtlpTracingAutoConfiguration          <- no actuator

               @ConditionalOnClass({ ConditionalOnEnabledLoggingExport.class,
                                     OpenTelemetry.class, SdkLoggerProvider.class })
               class OtlpLoggingAutoConfiguration          <- FIRST condition is
                                                              an actuator class

             ConditionalOnEnabledLoggingExport ships in
             spring-boot-actuator-autoconfigure. Drop actuator and the OTLP
             *logging* auto-configuration silently backs off while traces and
             metrics keep working — the asymmetry is easy to miss precisely
             because two of the three signals are fine.

             The failure is completely quiet: the endpoint property
             (management.opentelemetry.logging.export.otlp.endpoint) still
             binds, the OpenTelemetry bean still exists, OpenTelemetryAppender
             .install() still runs and the appender still accepts records — but
             the SDK has no LoggerProvider behind it, so every record is
             dropped. Nothing is logged about it. Loki simply stays empty.

             Removing this dependency "because there is no HTTP server" is
             therefore a one-line way to lose all logs with no error message. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Logback -> OpenTelemetry logs bridge. Boot 4 auto-configures the
             logging SDK and its OTLP exporter (given actuator above), but does
             NOT connect Logback to it: the appender must be declared in
             logback-spring.xml and armed with OpenTelemetryAppender.install().
             Without this dependency the logs endpoint binds, the SDK starts,
             and nothing ever reaches Loki. -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
            <version>${otel-instrumentation.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
