<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xkondix</groupId>
        <artifactId>ai-agents-JAVA-SPRING</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>common</artifactId>
    <name>Common - Shared DTOs, contracts and utilities</name>
    <description>
        Shared module: DTOs, request/response models, tool contracts,
        approval flow, AC Milan domain data,
        and shared observability auto-configuration.
        All agent and MCP server modules depend on this.
    </description>

    <dependencies>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.validation</groupId>
            <artifactId>jakarta.validation-api</artifactId>
        </dependency>

        <!-- ── Observability auto-configuration ─────────────────────────
             Marked optional: consumers already bring these transitively
             (spring-boot-starter-web + actuator + micrometer from parent).
             The auto-config activates only in servlet web apps.        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Servlet API is "optional" inside spring-web, so it does not come
             transitively. Needed at compile time because
             ServerRequestObservationContext#getCarrier() returns
             HttpServletRequest. Scope provided: at runtime embedded Tomcat
             (spring-boot-starter-web) supplies it in every consumer.    -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- ── Logback -> OpenTelemetry logs bridge ─────────────────────
             NOT optional, and NOT transitive by accident: this is the one
             piece that makes application logs reach Loki, and it is placed
             here so all nine modules inherit it from a single declaration.

             Spring Boot 4 auto-configures the logging SDK and its OTLP
             exporter, but does NOT connect Logback to it. Two things are
             ours, both also in this module:
               logback-spring.xml                 declares the appender
               OtelLoggingBridgeAutoConfiguration arms it via install()
             Skip either and the endpoint still binds, the SDK still starts,
             and not a single line reaches Loki — with no error anywhere.

             Version pinned in the parent: Boot manages opentelemetry-bom but
             not the io.opentelemetry.instrumentation group.               -->
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
        </dependency>
        <!-- OpenTelemetry API — for the OpenTelemetry bean injected by the
             bridge auto-configuration. Optional: every consumer already has
             it through spring-boot-starter-opentelemetry (parent).        -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- LangChain4j — ONLY for the GenAI metrics/tracing listener and the
             TracingToolProvider decorator. Both are OPTIONAL dependencies:
             the auto-config activates via @ConditionalOnClass exclusively in
             modules that already ship LangChain4j; Spring AI and raw modules
             never see these classes.
             langchain4j-core → ChatModelListener (metrics/spans listener)
             langchain4j      → ToolProvider / ToolExecutor / ToolSpecifications
                                (dev.langchain4j.service.tool lives here, not in core)
             Versions managed by langchain4j-bom (parent).                -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Tracer API for manual "chat <model>" spans in the LC4j listener.
             Consumers get the implementation from micrometer-tracing-bridge-otel
             (parent); optional here for the same reason as the rest.     -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
