<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.xkondix</groupId>
        <artifactId>ai-agents-JAVA-SPRING</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>langchain4j-agent-local</artifactId>
    <name>LangChain4j Agent Local - Raw loop + AiServices</name>
    <description>
        Demonstrates the agent loop concept using LangChain4j
        with LOCAL tools (@Tool annotation, same process).

        1. RAW LOOP    - manual while-loop without any framework abstractions.
        2. AI SERVICES - declarative @Tool + AiServices (annotation approach),
                         in-memory MessageWindowChatMemory keyed by userId.

        Persistent (Redis) memory is NOT part of this module today: the
        langchain4j-community Redis starter is kept commented out below until
        a spring-boot4 variant is confirmed, and the former spring.data.redis
        properties were removed from application.yml because they bound to
        nothing.

        Port: 8082
    </description>

    <dependencies>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Core artifacts: independent of the Spring Boot version,
             unchanged by the Boot 4 migration. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-core</artifactId>
        </dependency>

        <!-- STARTERS: the spring-boot4 family, not spring-boot.
             LangChain4j ships two parallel starter families at the SAME
             version, told apart only by artifactId:
               langchain4j-*-spring-boot-starter   -> Spring Boot 3.5+
               langchain4j-*-spring-boot4-starter  -> Spring Boot 4.0+
             Both are managed by langchain4j-bom 1.16.3, so swapping them
             needs no version change on the BOM.

             The Boot 3 variant does NOT work on Boot 4: its auto-configurations
             import classes that changed package in Boot 4 (for example
             org.springframework.boot.autoconfigure.web.client.RestClientAutoConfiguration
             -> org.springframework.boot.restclient.autoconfigure.RestClientAutoConfiguration),
             which fails with IllegalStateException: Failed to generate bean
             name for imported class. The symptom is loud but misleading - it
             looks like a bean problem and is a starter-version problem. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama-spring-boot4-starter</artifactId>
        </dependency>

        <!-- OpenAI-compatible starter - used by the "openrouter" Spring
             profile (langchain4j.open-ai.* properties). Property-driven:
             with the "local" profile no open-ai properties exist, so no
             OpenAI model bean is created and no API key is required. -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai-spring-boot4-starter</artifactId>
        </dependency>

        <!--
            Redis chat memory - moved to langchain4j-community in LangChain4j 1.x.
            Not wired in. To restore: check whether langchain4j-community ships a
            -spring-boot4- starter for Redis, add it here together with
            spring-boot-starter-data-redis, and bring spring.data.redis.* back to
            application.yml (docker-compose has Redis behind - -profile extras).
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-redis-spring-boot-starter</artifactId>
            <version>1.0.0-beta5</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        -->

        <!-- Actuator: management endpoints (health is polled by the chat-ui). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>com.xkondix</groupId>
            <artifactId>common</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
